# Copy this file to ".env" and fill in your own values. Never commit ".env".

# --- NAMS (Neo4j Agent Memory Service) -------------------------------------
MEMORY_API_KEY=nams_your_key_here
MEMORY_ENDPOINT=https://memory.neo4jlabs.com/v1
# Only needed if your NAMS deployment scopes by header instead of by API key.
# MEMORY_WORKSPACE_ID=

# --- Chat model (one provider, OpenAI-compatible) --------------------------
LLM_PROVIDER=openai
LLM_API_KEY=sk-your-key-here
LLM_MODEL=gpt-4o-mini
# Leave unset for api.openai.com. Set it to use another OpenAI-compatible
# server (Groq, OpenRouter, Ollama, Gemini's OpenAI endpoint, ...).
# LLM_BASE_URL=

# --- Embeddings for ChromaDB (configured separately from the chat model) ---
EMBEDDING_MODEL=text-embedding-3-small
# If EMBEDDING_API_KEY is empty AND neither LLM_BASE_URL nor EMBEDDING_BASE_URL
# is set, LLM_API_KEY is reused (both then talk to api.openai.com).
# EMBEDDING_API_KEY=
# EMBEDDING_BASE_URL=

# --- ChromaDB and retrieval ------------------------------------------------
CHROMA_DIR=data/chroma
CHROMA_COLLECTION=documents
CHUNK_SIZE=800
CHUNK_OVERLAP=100
MAX_UPLOAD_MB=10
RETRIEVAL_TOP_K=4
# Cosine distance cut-off: chunks farther away than this are ignored (0 = identical).
RETRIEVAL_MAX_DISTANCE=0.75

# --- Chat behaviour --------------------------------------------------------
HISTORY_MESSAGES=6
MEMORY_ENTITY_LIMIT=5
# 0 = never wait for NAMS extraction during /chat (recommended).
# >0 = wait up to this many seconds, then report whatever state NAMS is in.
EXTRACTION_WAIT_SECONDS=0
